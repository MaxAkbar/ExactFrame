<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-independent logic: geometry, models, settings, service contracts and the
    main view model. No Windows or WinUI references, so it builds and tests anywhere.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExactFrame.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExactFrame.Core.Tests" />
  </ItemGroup>
</Project>
