<Window
    x:Class="ExactFrame.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExactFrame.Controls"
    xmlns:helpers="using:ExactFrame.Helpers"
    xmlns:vm="using:ExactFrame.Core.ViewModels"
    Title="ExactFrame">

    <Grid x:Name="Root" Background="{StaticResource GroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <KeyboardAccelerator Key="F1" Invoked="OnHelpInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- ===== Title bar: app name, mode switch, profile ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Border Width="28" Height="28" Background="{StaticResource AccentBrush}" CornerRadius="8">
                    <Path
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 5,10 L 5,5 L 10,5 M 14,5 L 19,5 L 19,10 M 19,14 L 19,19 L 14,19 M 10,19 L 5,19 L 5,14"
                        Stroke="White"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2.2" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SansSemiBoldFont}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource InkBrush}"
                Text="ExactFrame" />
            </StackPanel>

            <Border
                x:Name="ModeSwitch"
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="{StaticResource TitleTrackBrush}"
                CornerRadius="10"
                Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton
                        Padding="18,0"
                        Click="OnTitleBarNavigate"
                        Command="{x:Bind ViewModel.ShowOutlineModeCommand}"
                        Content="Outline area"
                        GroupName="Mode"
                        IsChecked="{x:Bind ViewModel.IsOutlineMode, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        MinHeight="32"
                        Style="{StaticResource SegmentRadioStyle}"
                        ToolTipService.ToolTip="Show an outline around the area you will record" />
                    <RadioButton
                        Padding="18,0"
                        Click="OnTitleBarNavigate"
                        Command="{x:Bind ViewModel.ShowResizeModeCommand}"
                        Content="Resize window"
                        GroupName="Mode"
                        IsChecked="{x:Bind ViewModel.IsResizeMode, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        MinHeight="32"
                        Style="{StaticResource SegmentRadioStyle}"
                        ToolTipService.ToolTip="Resize another app so its content is an exact size" />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Column="2"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    x:Name="HelpButton"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="Help"
                    Click="OnHelpButtonClick"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="Help (F1)">
                    <FontIcon FontSize="16" Glyph="&#xE897;" />
                </Button>
                <Button
                    x:Name="ProfileButton"
                    Padding="12,0,10,0"
                    VerticalAlignment="Center"
                    Click="OnTitleBarNavigate"
                    Command="{x:Bind ViewModel.OpenProfilesCommand}"
                    MinHeight="36"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTipService.ToolTip="Saved profiles">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{x:Bind ViewModel.ProfileEyebrow, Mode=OneWay}" />
                            <TextBlock
                                FontFamily="{StaticResource SansSemiBoldFont}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Body: preview stage and settings ===== -->
        <Grid
            Grid.Row="1"
            Padding="24,4,24,20"
            ColumnSpacing="20"
            Visibility="{x:Bind helpers:Format.Collapsed(Help.IsOpen), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Stage -->
            <Grid Background="{StaticResource StageBrush}" CornerRadius="16" Padding="24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="{x:Bind helpers:Format.Upper(ViewModel.StageEyebrow), Mode=OneWay}" />
                        <TextBlock
                            FontFamily="{StaticResource MonoSemiBoldFont}"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource StageBrightBrush}"
                            Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" />
                        <TextBlock FontSize="13" Foreground="{StaticResource StageMutedBrush}" Text="{x:Bind ViewModel.StageSubtitle, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                        <Border Height="30" Padding="12,0" Background="{x:Bind helpers:Format.ChipBrush(ViewModel.IsChipLive), Mode=OneWay}" CornerRadius="15">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="7" Height="7" Fill="{x:Bind helpers:Format.ChipDotBrush(ViewModel.IsChipLive), Mode=OneWay}" />
                                <TextBlock FontSize="12.5" Foreground="{x:Bind helpers:Format.ChipTextBrush(ViewModel.IsChipLive), Mode=OneWay}" Text="{x:Bind ViewModel.ChipText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Height="30" Padding="12,0" Background="{StaticResource StageChipBrush}" CornerRadius="15" Visibility="{x:Bind ViewModel.ShowRecorderChip, Mode=OneWay}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Foreground="{StaticResource StageSoftBrush}" Glyph="&#xED1A;" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource StageSoftBrush}" Text="Hidden from recorders" />
                            </StackPanel>
                        </Border>
                        <Border Height="30" Padding="12,0" Background="{StaticResource StageChipBrush}" CornerRadius="15" Visibility="{x:Bind ViewModel.ShowLockChip, Mode=OneWay}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Foreground="{StaticResource StageSoftBrush}" Glyph="&#xE72E;" />
                                <TextBlock FontSize="12.5" Foreground="{StaticResource StageSoftBrush}" Text="Click-through" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Foreground="{StaticResource StageSoftBrush}" Glyph="&#xE7F4;" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource StageSoftBrush}" Text="{x:Bind ViewModel.DisplayLabel, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Foreground="{x:Bind helpers:Format.FitBrush(ViewModel.IsFit), Mode=OneWay}" Glyph="{x:Bind helpers:Format.FitGlyph(ViewModel.IsFit), Mode=OneWay}" />
                        <TextBlock
                            FontFamily="{StaticResource SansMediumFont}"
                            FontSize="12.5"
                            FontWeight="Medium"
                            Foreground="{x:Bind helpers:Format.FitBrush(ViewModel.IsFit), Mode=OneWay}"
                            Text="{x:Bind ViewModel.FitText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <controls:DisplayMap Grid.Row="2" State="{x:Bind ViewModel.Preview, Mode=OneWay}" />

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="DISPLAY" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Displays}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DisplayItem">
                                    <RadioButton
                                        Command="{x:Bind SelectCommand}"
                                        GroupName="Display"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Style="{StaticResource StageRadioStyle}"
                                        ToolTipService.ToolTip="{x:Bind DeviceName}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Grid Width="28">
                                                <Border
                                                    Width="{x:Bind GlyphWidth}"
                                                    Height="{x:Bind GlyphHeight}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{x:Bind helpers:Format.ChipDotBrush(IsSelected), Mode=OneWay}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="2" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontFamily="{StaticResource SansSemiBoldFont}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource StageTextBrush}"
                                                    Text="{x:Bind Title}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource MonoFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource StageMutedBrush}"
                                                    Text="{x:Bind Resolution}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Bottom" ColumnSpacing="22" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="LEFT" />
                        <TextBlock Grid.Column="1" Style="{StaticResource EyebrowStyle}" Text="TOP" />
                        <TextBlock Grid.Column="2" Style="{StaticResource EyebrowStyle}" Text="RIGHT" />
                        <TextBlock Grid.Column="3" Style="{StaticResource EyebrowStyle}" Text="BOTTOM" />
                        <TextBlock Grid.Row="1" Style="{StaticResource StageValueStyle}" Text="{x:Bind ViewModel.BoundsLeft, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StageValueStyle}" Text="{x:Bind ViewModel.BoundsTop, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource StageValueStyle}" Text="{x:Bind ViewModel.BoundsRight, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource StageValueStyle}" Text="{x:Bind ViewModel.BoundsBottom, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Settings -->
            <Border
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <SelectorBar
                        x:Name="Tabs"
                        Margin="10,6,10,0"
                        VerticalAlignment="Bottom"
                        SelectionChanged="OnTabSelectionChanged"
                        Visibility="{x:Bind ViewModel.IsOutlineMode, Mode=OneWay}">
                        <SelectorBarItem x:Name="FrameTab" IsSelected="True" Text="Frame" />
                        <SelectorBarItem x:Name="StyleTab" Text="Style" />
                        <SelectorBarItem x:Name="ProfilesTab" Text="Profiles" />
                    </SelectorBar>

                    <Grid Padding="20,0,14,0" Visibility="{x:Bind ViewModel.IsResizeMode, Mode=OneWay}">
                        <TextBlock VerticalAlignment="Center" FontSize="15" Style="{StaticResource SectionTitleStyle}" Text="Window to resize" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.PickWindowCommand}"
                            Style="{StaticResource SmallButtonStyle}"
                            ToolTipService.ToolTip="Click any app window to choose it. Right-click or Esc cancels.">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="13" Glyph="&#xE718;" />
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource SansMediumFont}" FontWeight="Medium" Text="Pick on screen" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource DividerBrush}" />

                    <Grid x:Name="PanelHost" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Help and About: replaces the body while open ===== -->
        <Grid
            x:Name="HelpHost"
            Grid.Row="1"
            Padding="24,4,24,20"
            Visibility="{x:Bind Help.IsOpen, Mode=OneWay}" />

        <!-- ===== Footer: status and actions ===== -->
        <Grid
            Grid.Row="2"
            Padding="24,0"
            Background="{StaticResource FooterBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="18" Height="18">
                    <Ellipse Fill="{x:Bind helpers:Format.StatusHalo(ViewModel.StatusKind), Mode=OneWay}" />
                    <Ellipse Width="10" Height="10" Fill="{x:Bind helpers:Format.StatusBrush(ViewModel.StatusKind), Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{StaticResource MutedBrush}"
                        Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Button
                    Command="{x:Bind ViewModel.CopyBoundsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTipService.ToolTip="Copy X, Y, width and height for your recorder"
                    Visibility="{x:Bind ViewModel.IsOutlineMode, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid>
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" Visibility="{x:Bind ViewModel.IsNotCopied, Mode=OneWay}" />
                            <FontIcon FontSize="14" Foreground="{StaticResource AccentBrush}" Glyph="&#xE73E;" Visibility="{x:Bind ViewModel.IsCopied, Mode=OneWay}" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource SansMediumFont}" FontWeight="Medium" Text="{x:Bind ViewModel.CopyLabel, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{x:Bind ViewModel.BoundsText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{x:Bind ViewModel.RestoreCommand}"
                    Content="Restore original size"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTipService.ToolTip="Put the window back where and how it was before the first resize this session"
                    Visibility="{x:Bind ViewModel.IsResizeMode, Mode=OneWay}" />

                <Button
                    MinWidth="180"
                    Background="{x:Bind helpers:Format.PrimaryBrush(ViewModel.PrimaryIsHide), Mode=OneWay}"
                    Command="{x:Bind ViewModel.PrimaryCommand}"
                    Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SansSemiBoldFont}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PrimaryLabel, Mode=OneWay}" />
                        <controls:KeyChips
                            VerticalAlignment="Center"
                            Keys="{x:Bind ViewModel.PrimaryHotkeyKeys, Mode=OneWay}"
                            Variant="OnAccent"
                            Visibility="{x:Bind ViewModel.ShowPrimaryHotkey, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
