<UserControl
    x:Class="ExactFrame.Views.OutputSizeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="10" RowSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Width" Style="{StaticResource LabelStyle}" />
        <Slider x:Name="WidthSlider" Grid.Column="1" AutomationProperties.Name="Subframe output width"
                Minimum="100" SmallChange="2" LargeChange="64" StepFrequency="1" IsThumbToolTipEnabled="False"
                VerticalAlignment="Center" ValueChanged="OnWidthChanged" />
        <NumberBox Grid.Column="2" AutomationProperties.Name="Subframe output width in pixels"
                   Minimum="100" Maximum="16384" Style="{StaticResource PixelBoxStyle}"
                   Value="{x:Bind Item.OutputWidth, Mode=TwoWay}" />
        <TextBlock Grid.Row="1" Text="Height" Style="{StaticResource LabelStyle}" />
        <Slider x:Name="HeightSlider" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Subframe output height"
                Minimum="100" SmallChange="2" LargeChange="64" StepFrequency="1" IsThumbToolTipEnabled="False"
                VerticalAlignment="Center" ValueChanged="OnHeightChanged" />
        <NumberBox Grid.Row="1" Grid.Column="2" AutomationProperties.Name="Subframe output height in pixels"
                   Minimum="100" Maximum="16384" Style="{StaticResource PixelBoxStyle}"
                   Value="{x:Bind Item.OutputHeight, Mode=TwoWay}" />
    </Grid>
</UserControl>
