<UserControl
    x:Class="ExactFrame.Views.ResizePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ExactFrame.Views"
    xmlns:helpers="using:ExactFrame.Helpers"
    xmlns:vm="using:ExactFrame.Core.ViewModels">

    <ScrollViewer
        HorizontalScrollMode="Disabled"
        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
        VerticalScrollBarVisibility="Auto"
        Visibility="{x:Bind ViewModel.IsResizeMode, Mode=OneWay}">
        <StackPanel Padding="20,16,20,20" Spacing="18">

            <Expander Header="Match this application" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.TargetApplicationText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBox Header="Application process name" AutomationProperties.Name="Target application process" MaxLength="120" PlaceholderText="For example, msedge or devenv"
                             Text="{x:Bind ViewModel.TargetProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Optional conditions must all match. Blank fields allow any value. Matching uses literal text and ignores letter case." TextWrapping="Wrap" />
                    <Button Content="Use selected window details" Command="{x:Bind ViewModel.UseSelectedWindowMatchCommand}" Style="{StaticResource SmallButtonStyle}" />
                    <TextBox Header="Executable path (exact)" AutomationProperties.Name="Target executable path" MaxLength="2048"
                             Text="{x:Bind ViewModel.TargetExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Window title" AutomationProperties.Name="Target window title" MaxLength="2048"
                             Text="{x:Bind ViewModel.TargetTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Header="Title matching" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.TargetTitleModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Contains" /><ComboBoxItem Content="Exact" />
                    </ComboBox>
                    <TextBox Header="Window class (exact)" AutomationProperties.Name="Target window class" MaxLength="2048"
                             Text="{x:Bind ViewModel.TargetClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear conditions" Command="{x:Bind ViewModel.ClearWindowMatchCommand}" Style="{StaticResource SmallButtonStyle}" />
                        <Button Content="Refresh matches" Command="{x:Bind ViewModel.RefreshWindowsCommand}" Style="{StaticResource SmallButtonStyle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.TargetMatchSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ScrollViewer MaxHeight="180" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MatchingWindows}">
                            <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WindowItem">
                                    <RadioButton GroupName="MatchingWindow" Command="{x:Bind SelectCommand}" IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                 Style="{StaticResource ChipRadioStyle}" ToolTipService.ToolTip="{x:Bind Title}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Border Padding="10" Background="{ThemeResource FooterBrush}" CornerRadius="6">
                        <TextBlock Text="{x:Bind ViewModel.TargetWindowPreview, Mode=OneWay}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Manual resizing remembers the size for these conditions. Save a profile to keep the conditions with a complete setup." TextWrapping="Wrap" />
                    <Button Content="Save setup as profile" Command="{x:Bind ViewModel.SaveProfileCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Update active resize profile" Command="{x:Bind ViewModel.UpdateTargetProfileCommand}"
                            Visibility="{x:Bind ViewModel.HasActiveResizeProfile, Mode=OneWay}" Style="{StaticResource SmallButtonStyle}" />
                </StackPanel>
            </Expander>

            <!-- Window list -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.Name="Search open windows"
                        PlaceholderText="Search open windows"
                        Text="{x:Bind ViewModel.WindowFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="40"
                        AutomationProperties.Name="Refresh window list"
                        Command="{x:Bind ViewModel.RefreshWindowsCommand}"
                        Style="{StaticResource SmallButtonStyle}"
                        ToolTipService.ToolTip="Refresh the list after opening or closing apps">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="No matching windows. Open an app, then refresh." Visibility="{x:Bind ViewModel.HasNoWindows, Mode=OneWay}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Windows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowItem">
                            <RadioButton
                                MinHeight="46"
                                Padding="10,6"
                                BorderBrush="Transparent"
                                Command="{x:Bind SelectCommand}"
                                GroupName="TargetWindow"
                                AutomationProperties.Name="{x:Bind Title}"
                                AutomationProperties.HelpText="{x:Bind Meta}"
                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                Style="{StaticResource ChipRadioStyle}"
                                ToolTipService.ToolTip="{x:Bind Title}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" Background="{x:Bind helpers:Format.Brush(Tint)}" CornerRadius="7">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource SansSemiBoldFont}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind Initials}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontFamily="{StaticResource SansMediumFont}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{ThemeResource InkBrush}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11.5" Foreground="{ThemeResource MutedBrush}" Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="14"
                                        Foreground="{ThemeResource AccentBrush}"
                                        Glyph="&#xE73E;"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasRememberedAppSize, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="{x:Bind ViewModel.RememberedAppSizeText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.ForgetAppSizeCommand}"
                        Content="Forget size"
                        Style="{StaticResource SmallButtonStyle}" />
                </Grid>
            </StackPanel>

            <Border Style="{StaticResource DividerStyle}" />

            <!-- Target size -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Target size" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="Physical pixels" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Presets}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="6"
                            MinColumnSpacing="6"
                            MinItemHeight="34"
                            MinItemWidth="50"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceItem">
                            <RadioButton
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                Command="{x:Bind SelectCommand}"
                                CornerRadius="8"
                                GroupName="ResizePreset"
                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                Style="{StaticResource ChipRadioStyle}"
                                ToolTipService.ToolTip="{x:Bind Detail}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{StaticResource SansSemiBoldFont}"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource InkBrush}"
                                    Text="{x:Bind Label}" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <views:SizeEditor ViewModel="{x:Bind ViewModel}" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.LogicalSizeNote, Mode=OneWay}" TextWrapping="Wrap" />

                <Grid MinHeight="36">
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Size applies to" />
                    <Border Style="{StaticResource SegmentTrackStyle}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MeasureOptions}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceItem">
                                    <RadioButton
                                        Command="{x:Bind SelectCommand}"
                                        Content="{x:Bind Label}"
                                        GroupName="Measure"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Style="{StaticResource SegmentRadioStyle}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.MeasureNote, Mode=OneWay}" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="Browser CSS viewport, page zoom and device-pixel ratio (DPR): not measured. See Help → Resize window to check them." TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource DividerStyle}" />

            <!-- Placement -->
            <StackPanel Spacing="10">
                <Grid MinHeight="36">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="Placement" />
                    <Border Style="{StaticResource SegmentTrackStyle}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PlacementOptions}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceItem">
                                    <RadioButton
                                        Command="{x:Bind SelectCommand}"
                                        Content="{x:Bind Label}"
                                        GroupName="Placement"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Style="{StaticResource SegmentRadioStyle}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </Grid>
                <CheckBox Content="Keep clear of the taskbar" IsChecked="{x:Bind ViewModel.KeepClearOfTaskbar, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
