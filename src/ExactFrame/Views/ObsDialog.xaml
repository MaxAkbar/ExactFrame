<ContentDialog
    x:Class="ExactFrame.Views.ObsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExactFrame.Controls"
    Title="Send to OBS"
    CloseButtonText="Close"
    Closing="OnClosing">
    <ScrollViewer Width="560" MaxHeight="600" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="0,0,8,8">
            <TextBlock Text="Connect to OBS Studio 28 or later on this PC, then preview a frame on an existing Display Capture source." TextWrapping="Wrap" />
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsDisconnected, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <NumberBox Header="Server port" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Minimum="1" Maximum="65535" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" SpinButtonPlacementMode="Inline" />
                    <PasswordBox Grid.Column="1" Header="OBS server password" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Connect" Command="{x:Bind ViewModel.ConnectCommand}" Visibility="{x:Bind ViewModel.IsDisconnected, Mode=OneWay}" />
                    <Button Content="Refresh OBS" Command="{x:Bind ViewModel.RefreshCommand}" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                    <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}" Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                </StackPanel>
                <TextBlock FontSize="12" Text="The password is cleared after connecting and is never saved." TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsDisconnected, Mode=OneWay}" />
            </StackPanel>
            <Border Padding="12" Background="{ThemeResource FooterBrush}" CornerRadius="8">
                <StackPanel Spacing="6">
                    <ProgressRing Width="18" Height="18" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="10">
                <ComboBox Header="ExactFrame region" IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Regions}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedRegion, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Header="OBS scene" IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Scenes}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedScene, Mode=OneWay}" SelectionChanged="OnSceneChanged" HorizontalAlignment="Stretch" />
                <ComboBox Header="Display Capture source" IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Sources}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Header="Placement on the existing OBS canvas" IsEnabled="{x:Bind ViewModel.CanChoose, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.PlacementIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Fit to canvas — keep aspect ratio" />
                    <ComboBoxItem Content="Actual pixels — center without scaling" />
                </ComboBox>
                <Button Content="Preview change" Command="{x:Bind ViewModel.PreviewCommand}" />
            </StackPanel>
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
                <TextBlock Text="Proposed canvas placement" FontWeight="SemiBold" />
                <controls:ObsCanvasPreview Height="170" Plan="{x:Bind ViewModel.Plan, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.PreviewDetails, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.ChangeDescription, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Apply to OBS" Command="{x:Bind ViewModel.ApplyCommand}" Background="{ThemeResource AccentBrush}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Undo last apply" Command="{x:Bind ViewModel.UndoCommand}" />
            </StackPanel>
            <TextBlock FontSize="12" Text="The scene item must be visible, unlocked and unfiltered. Stop recording or streaming before applying or undoing. Check OBS's preview before recording." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
