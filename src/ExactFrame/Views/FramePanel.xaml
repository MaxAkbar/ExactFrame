<UserControl
    x:Class="ExactFrame.Views.FramePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ExactFrame.Views"
    xmlns:controls="using:ExactFrame.Controls"
    xmlns:helpers="using:ExactFrame.Helpers"
    xmlns:vm="using:ExactFrame.Core.ViewModels">

    <ScrollViewer
        HorizontalScrollMode="Disabled"
        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
        VerticalScrollBarVisibility="Auto"
        Visibility="{x:Bind ViewModel.ShowFramePanel, Mode=OneWay}">
        <StackPanel Padding="20" Spacing="20">

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="Draw on screen" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.DrawFrameCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Drag a new frame on one display. Esc or right-click cancels." />
                    <Button Grid.Column="1" Content="Use window bounds" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UseWindowBoundsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Pick a window as the starting frame. Its size stays unchanged." />
                </Grid>
                <CheckBox Content="Snap to edges and centers" IsChecked="{x:Bind ViewModel.SnapToEdges, Mode=TwoWay}"
                          ToolTipService.ToolTip="Align frame moves and handle resizes with display and nearby window edges or centers. Keyboard adjustments remain exact." />
            </StackPanel>

            <!-- Size -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Size" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionStyle}"
                        Text="Physical pixels"
                        ToolTipService.ToolTip="Sizes stay exact at 125%, 150% or 200% Windows scaling." />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Presets}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="3"
                            MinColumnSpacing="8"
                            MinItemHeight="46"
                            MinItemWidth="100"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChoiceItem">
                            <RadioButton
                                Command="{x:Bind SelectCommand}"
                                GroupName="FramePreset"
                                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                Style="{StaticResource ChipRadioStyle}">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        FontFamily="{StaticResource SansSemiBoldFont}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource InkBrush}"
                                        Text="{x:Bind Label}" />
                                    <TextBlock
                                        FontFamily="{StaticResource MonoFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="{x:Bind Detail}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <views:SizeEditor ViewModel="{x:Bind ViewModel}" />

                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.LogicalSizeNote, Mode=OneWay}" />
            </StackPanel>

            <Border Style="{StaticResource DividerStyle}" />

            <!-- Additional recording guides -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Additional frames" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="Compose several outputs from one recording frame. Drag a crop below or enter its position, then choose the final output size." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Command="{x:Bind ViewModel.AddShortsFrameCommand}" Content="+ 9:16" Style="{StaticResource SmallButtonStyle}" ToolTipService.ToolTip="Add a vertical Shorts frame" />
                    <Button Command="{x:Bind ViewModel.AddSquareFrameCommand}" Content="+ 1:1" Style="{StaticResource SmallButtonStyle}" ToolTipService.ToolTip="Add a square frame" />
                    <Button Command="{x:Bind ViewModel.AddPortraitFrameCommand}" Content="+ 4:5" Style="{StaticResource SmallButtonStyle}" ToolTipService.ToolTip="Add a portrait frame" />
                    <Button Command="{x:Bind ViewModel.AddCustomFrameCommand}" Content="+ Custom" Style="{StaticResource SmallButtonStyle}" ToolTipService.ToolTip="Add a frame with an editable aspect ratio" />
                </StackPanel>
                <Button Content="Preview outputs" Command="{x:Bind ViewModel.PreviewOutputsCommand}" Style="{StaticResource SecondaryButtonStyle}"
                        ToolTipService.ToolTip="Compare final compositions and optionally refresh a local screen snapshot" />
                <TextBlock Style="{StaticResource CaptionStyle}" Text="No additional frames. Add 9:16 for a Shorts guide inside a 16:9 main frame." Visibility="{x:Bind ViewModel.HasNoNestedFrames, Mode=OneWay}" TextWrapping="Wrap" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.NestedFrames}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:NestedFrameItem">
                            <Border Padding="12" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" VerticalAlignment="Center" Background="{x:Bind helpers:Format.Brush(ColorHex)}" CornerRadius="5" />
                                        <TextBox Grid.Column="1" AutomationProperties.Name="Composition name" MaxLength="80" Text="{x:Bind Name, Mode=TwoWay}" />
                                        <Button Grid.Column="2" HorizontalAlignment="Right" AutomationProperties.Name="Remove additional frame" Command="{x:Bind RemoveCommand}" Content="Remove" Style="{StaticResource GhostButtonStyle}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Dimensions, Mode=OneWay}" />
                                    <ComboBox Header="Output size" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind OutputPresetIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Guide only" />
                                        <ComboBoxItem Content="Shorts · 1080 × 1920" />
                                        <ComboBoxItem Content="Square · 1080 × 1080" />
                                        <ComboBoxItem Content="Portrait · 1080 × 1350" />
                                        <ComboBoxItem Content="Landscape · 1920 × 1080" />
                                        <ComboBoxItem Content="Custom output" />
                                    </ComboBox>
                                    <views:OutputSizeEditor Item="{x:Bind}" Visibility="{x:Bind HasOutput, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ScalingSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox Header="Ratio W" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" Value="{x:Bind AspectWidth, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="1" Header="Ratio H" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" Value="{x:Bind AspectHeight, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="2" Header="Scale %" Minimum="10" Maximum="100" SpinButtonPlacementMode="Inline" Value="{x:Bind ScalePercent, Mode=TwoWay}" />
                                    </Grid>
                                    <ComboBox Header="Position inside main frame" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind AnchorIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Top left" />
                                        <ComboBoxItem Content="Top center" />
                                        <ComboBoxItem Content="Top right" />
                                        <ComboBoxItem Content="Middle left" />
                                        <ComboBoxItem Content="Center" />
                                        <ComboBoxItem Content="Middle right" />
                                        <ComboBoxItem Content="Bottom left" />
                                        <ComboBoxItem Content="Bottom center" />
                                        <ComboBoxItem Content="Bottom right" />
                                        <ComboBoxItem Content="Free position" />
                                    </ComboBox>
                                    <controls:NestedPositionMap Item="{x:Bind}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Drag the colored crop. Arrows move 1 px; Shift moves 10. X and Y are relative to the main frame." TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <NumberBox Header="Crop X" Minimum="0" Maximum="16384" Value="{x:Bind XPosition, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="1" Header="Crop Y" Minimum="0" Maximum="16384" Value="{x:Bind YPosition, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <NumberBox Header="Edge inset (px)" Minimum="0" Maximum="1000" Value="{x:Bind InsetPixels, Mode=TwoWay}" />
                                        <NumberBox Grid.Column="1" Header="Safe margin (%)" Minimum="0" Maximum="40" Value="{x:Bind SafeMarginPercent, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <Border Style="{StaticResource DividerStyle}" />

            <!-- Position -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Position" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AnchorName, Mode=OneWay}" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        VerticalAlignment="Top"
                        Padding="6"
                        Background="{StaticResource FooterBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Anchors}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="3"
                                    MinColumnSpacing="4"
                                    MinItemHeight="26"
                                    MinItemWidth="28"
                                    MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnchorItem">
                                    <RadioButton
                                        AutomationProperties.Name="{x:Bind Label}"
                                        Command="{x:Bind SelectCommand}"
                                        GroupName="Anchor"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Style="{StaticResource AnchorRadioStyle}"
                                        ToolTipService.ToolTip="{x:Bind Label}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                Header="X"
                                Maximum="100000"
                                Minimum="-100000"
                                Style="{StaticResource PixelBoxStyle}"
                                Value="{x:Bind ViewModel.XValue, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="Y"
                                Maximum="100000"
                                Minimum="-100000"
                                Style="{StaticResource PixelBoxStyle}"
                                Value="{x:Bind ViewModel.YValue, Mode=TwoWay}" />
                        </Grid>
                        <CheckBox Content="Keep clear of the taskbar" IsChecked="{x:Bind ViewModel.KeepClearOfTaskbar, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource CaptionStyle}" Text="In the X and Y boxes, arrow keys nudge 1 px and Page Up / Page Down 10 px. You can also drag the outline." />
            </StackPanel>

            <Border Style="{StaticResource DividerStyle}" />

            <!-- Behavior -->
            <StackPanel Spacing="4">
                <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitleStyle}" Text="Behavior" />
                <Grid Padding="0,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongStyle}" Text="Click-through" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.ClickThroughHint, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Click-through"
                        IsOn="{x:Bind ViewModel.IsClickThrough, Mode=TwoWay}"
                        Style="{StaticResource BareSwitchStyle}" />
                </Grid>
                <Grid Padding="0,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongStyle}" Text="Hide from recorders" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.CaptureExclusionStatusText, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Hide from recorders"
                        IsOn="{x:Bind ViewModel.HideFromRecorders, Mode=TwoWay}"
                        Style="{StaticResource BareSwitchStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
