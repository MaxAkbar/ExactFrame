<UserControl
    x:Class="ExactFrame.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExactFrame.Controls"
    xmlns:help="using:ExactFrame.Core.Help"
    xmlns:helpers="using:ExactFrame.Helpers"
    xmlns:vm="using:ExactFrame.Core.ViewModels">

    <Border
        Background="{ThemeResource SurfaceBrush}"
        BorderBrush="{ThemeResource LineBrush}"
        BorderThickness="1"
        CornerRadius="16">
        <Grid x:Name="HelpLayout">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TopicsColumn" Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="CompactTopicsBar" Grid.ColumnSpan="2" Margin="16,12" Visibility="Collapsed" Spacing="6">
                <TextBox x:Name="CompactSearch" AutomationProperties.Name="Search help" PlaceholderText="Search help" Text="{x:Bind Help.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox x:Name="CompactTopics"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Choose a help topic"
                      ItemsSource="{x:Bind Help.VisibleTopics}" DisplayMemberPath="Title" SelectionChanged="OnCompactTopicChanged" />
            </StackPanel>

            <!-- ===== Topics ===== -->
            <Grid
                x:Name="TopicsPane" Grid.RowSpan="2"
                Padding="16,20,16,16"
                Background="{ThemeResource FooterBrush}"
                BorderBrush="{ThemeResource DividerBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="16,0,0,16"
                RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Padding="6,0,0,0" Spacing="2">
                    <TextBlock
                        FontFamily="{StaticResource SansSemiBoldFont}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource InkBrush}"
                        Text="Help" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Guides, shortcuts and fixes" />
                </StackPanel>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="1"
                    AutomationProperties.Name="Search help"
                    PlaceholderText="Search help"
                    Text="{x:Bind Help.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <ItemsRepeater ItemsSource="{x:Bind Help.VisibleTopics}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:HelpTopicItem">
                                    <RadioButton
                                        AutomationProperties.Name="{x:Bind Title}"
                                        Command="{x:Bind SelectCommand}"
                                        GroupName="HelpTopic"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Style="{StaticResource NavRadioStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontSize="15" Foreground="{x:Bind helpers:Format.NavBrush(IsSelected), Mode=OneWay}" Glyph="{x:Bind Glyph}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{x:Bind helpers:Format.NavFont(IsSelected), Mode=OneWay}"
                                                FontSize="13.5"
                                                FontWeight="{x:Bind helpers:Format.NavWeight(IsSelected), Mode=OneWay}"
                                                Foreground="{x:Bind helpers:Format.NavBrush(IsSelected), Mode=OneWay}"
                                                Text="{x:Bind Title}" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Margin="8,6,0,0"
                            Style="{StaticResource CaptionStyle}"
                            Text="No topics match. Try another word."
                            Visibility="{x:Bind Help.HasNoResults, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Topic ===== -->
            <Grid Grid.Row="1" Grid.Column="1">
                <ScrollViewer x:Name="ContentScroller" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="760"
                        Padding="36,28,36,36"
                        HorizontalAlignment="Left"
                        Spacing="26">

                        <StackPanel Margin="0,0,56,0" Spacing="6">
                            <TextBlock
                                FontFamily="{StaticResource SansSemiBoldFont}"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource InkBrush}"
                                Text="{x:Bind Help.SelectedTopic.Title, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource MutedBrush}"
                                Text="{x:Bind Help.SelectedTopic.Summary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Keyboard shortcuts: live, so changed or conflicting shortcuts show as they are -->
                        <StackPanel Spacing="10" Visibility="{x:Bind Help.ShowShortcuts, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="16" Text="Global shortcuts" />
                            <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="12">
                                <ItemsRepeater ItemsSource="{x:Bind Main.Hotkeys}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyItem">
                                            <Grid
                                                MinHeight="48"
                                                Padding="16,8"
                                                BorderBrush="{ThemeResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontSize="14" Foreground="{ThemeResource InkBrush}" Text="{x:Bind Label}" />
                                                    <TextBlock
                                                        FontFamily="{StaticResource SansMediumFont}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource WarnTextBrush}"
                                                        Text="{x:Bind ProblemHelp}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasConflict}" />
                                                </StackPanel>
                                                <controls:KeyChips
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    IsWarning="{x:Bind HasConflict}"
                                                    Keys="{x:Bind Keys}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource SectionTitleStyle}" FontSize="16" Text="In ExactFrame" />
                            <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="12">
                                <ItemsRepeater ItemsSource="{x:Bind Help.FixedShortcuts}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="help:ShortcutRow">
                                            <Grid
                                                MinHeight="48"
                                                Padding="16,8"
                                                BorderBrush="{ThemeResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource InkBrush}"
                                                    Text="{x:Bind Label}"
                                                    TextWrapping="Wrap" />
                                                <controls:KeyChips Grid.Column="1" VerticalAlignment="Center" Keys="{x:Bind Keys}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>
                        </StackPanel>

                        <!-- About: versions and settings location -->
                        <StackPanel Spacing="16" Visibility="{x:Bind Help.ShowAbout, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="44" Height="44" Background="{ThemeResource AccentBrush}" CornerRadius="12">
                                    <Path
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 5,10 L 5,5 L 10,5 M 14,5 L 19,5 L 19,10 M 19,14 L 19,19 L 14,19 M 10,19 L 5,19 L 5,14"
                                        Stroke="White"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2.2" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SansSemiBoldFont}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource InkBrush}"
                                    Text="{x:Bind Help.AppTitle}" />
                            </StackPanel>

                            <Border
                                Padding="16,6"
                                Background="{ThemeResource FooterBrush}"
                                BorderBrush="{ThemeResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <ItemsRepeater ItemsSource="{x:Bind Help.AboutRows}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AboutRow">
                                            <Grid Padding="0,8" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="13" Foreground="{ThemeResource MutedBrush}" Text="{x:Bind Label}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="{StaticResource MonoFont}"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource InkBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Value}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind Help.RevealSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource SansMediumFont}" FontWeight="Medium" Text="Open settings folder" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{x:Bind Help.CopySystemInfoCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTipService.ToolTip="Copies versions and display details to paste into a bug report">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource SansMediumFont}"
                                            FontWeight="Medium"
                                            Text="{x:Bind Help.CopyInfoLabel, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Topic text, rendered from Core's help content -->
                        <StackPanel x:Name="TopicBody" Spacing="26" />
                    </StackPanel>
                </ScrollViewer>

                <Button
                    Margin="0,20,20,0"
                    Padding="10,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Close help"
                    Command="{x:Bind Help.CloseCommand}"
                    MinHeight="34"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTipService.ToolTip="Close help (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource SansMediumFont}" FontSize="13" FontWeight="Medium" Text="Close" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
